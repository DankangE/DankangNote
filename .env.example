# 이 파일은 값이 아니라 **키 목록**이다. 복사해서 .env로 쓰고 값을 채운다.
#   cp .env.example .env
# 배포 환경에서는 같은 키를 Vercel 프로젝트의 환경변수로 등록한다 (docs/deploy-staging.md).
# NEXT_PUBLIC_ 접두사가 붙은 것만 브라우저 번들에 들어간다 — 나머지는 절대 붙이지 말 것.

# ── 데이터베이스 ──────────────────────────────────────────────
# 로컬: docker-compose.yml의 postgres 컨테이너와 짝을 이룬다.
# 배포: 관리형 Postgres의 연결 문자열. 서버리스는 요청마다 커넥션을 열므로
#       풀러가 있는 쪽(Neon이면 -pooler 호스트)을 쓴다.
# (docker-compose.yml의 POSTGRES_USER/PASSWORD/DB와 그대로 짝을 이룬다)
DATABASE_URL="postgresql://dankang:dankang@localhost:5432/dankangnote"

# 마이그레이션 재생용 격리 DB. 없어도 동작한다(prisma.config.ts 주석 참고).
# 공유 dev DB에 병행 브랜치의 마이그레이션이 섞였을 때 reset 없이 diff하려면 필요.
# SHADOW_DATABASE_URL=

# 테스트 전용 DB. 비워 두면 DATABASE_URL의 DB명에 _test를 붙여 파생한다
# (test/database-url.ts). 테스트는 매번 전 테이블을 TRUNCATE하므로 개발 DB와
# 같은 값이면 스스로 중단한다. CI처럼 전용 DB를 주입할 때만 채운다.
# TEST_DATABASE_URL=

# ── Clerk (인증 · 조직) ───────────────────────────────────────
# 대시보드 > API Keys. 개발 인스턴스 키와 배포 인스턴스 키는 다르다.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 웹훅 서명 검증용(Svix). 대시보드 > Webhooks > 엔드포인트 > Signing Secret.
# 로컬에는 보통 없다 — localhost로는 웹훅을 직접 받을 수 없기 때문이다.
# 배포 환경에서 미설정이면 /api/webhooks/clerk가 500을 돌려준다(400으로 뭉개면
# 위조 시도와 구분되지 않아 미러가 조용히 어긋난다).
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Pusher (실시간) ──────────────────────────────────────────
# 대시보드 > App Keys. key와 cluster만 클라이언트에 노출된다.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ── 파일 첨부 스토리지 (KAN-35, S3 호환) ─────────────────────
# 로컬: docker-compose의 MinIO와 짝을 이룬다(아래 값 그대로).
# 배포: R2·S3 등 S3 호환 서비스의 값으로 교체 — 코드는 갈라지지 않는다(storage.ts).
# 엔드포인트는 **브라우저에서 접근 가능**해야 한다. 업로드·다운로드가 presigned URL로
# 스토리지에 직접 붙는 구조라, 내부 전용 주소를 넣으면 서버만 되고 브라우저가 실패한다.
# 5종이 다 없으면 첨부 기능만 조용히 꺼진다(채팅의 나머지는 동작).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="dankang"
S3_SECRET_ACCESS_KEY="dankang-minio"
S3_BUCKET="dankangnote-attachments"

# ── 스케줄 작업 (KAN-70) ─────────────────────────────────────
# 스토리지 정리 스윕(/api/cron/storage-cleanup)의 호출 시크릿. Vercel Cron이
# `Authorization: Bearer <값>`으로 보낸다(등록은 KAN-27). 로컬은 아무 난수나 넣고
# 같은 헤더로 curl 하면 된다. 미설정이면 라우트가 전부 401이다(fail-closed).
CRON_SECRET=
