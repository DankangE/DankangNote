# 이 파일은 값이 아니라 **키 목록**이다. 복사해서 .env로 쓰고 값을 채운다.
#   cp .env.example .env
# 배포 환경에서는 같은 키를 Vercel 프로젝트의 환경변수로 등록한다 (docs/deploy-staging.md).
# NEXT_PUBLIC_ 접두사가 붙은 것만 브라우저 번들에 들어간다 — 나머지는 절대 붙이지 말 것.

# ── 데이터베이스 ──────────────────────────────────────────────
# 로컬: docker-compose.yml의 postgres 컨테이너와 짝을 이룬다.
# 배포: 관리형 Postgres의 연결 문자열. 서버리스는 요청마다 커넥션을 열므로
#       풀러가 있는 쪽(Neon이면 -pooler 호스트)을 쓴다.
DATABASE_URL="postgresql://dankang:dankang@localhost:5432/dankangnote?schema=public"

# 마이그레이션 재생용 격리 DB. 없어도 동작한다(prisma.config.ts 주석 참고).
# 공유 dev DB에 병행 브랜치의 마이그레이션이 섞였을 때 reset 없이 diff하려면 필요.
# SHADOW_DATABASE_URL=

# 테스트 전용 DB. 비워 두면 DATABASE_URL의 DB명에 _test를 붙여 파생한다
# (test/database-url.ts). 테스트는 매번 전 테이블을 TRUNCATE하므로 개발 DB와
# 같은 값이면 스스로 중단한다. CI처럼 전용 DB를 주입할 때만 채운다.
# TEST_DATABASE_URL=

# ── Clerk (인증 · 조직) ───────────────────────────────────────
# 대시보드 > API Keys. 개발 인스턴스 키와 배포 인스턴스 키는 다르다.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 웹훅 서명 검증용(Svix). 대시보드 > Webhooks > 엔드포인트 > Signing Secret.
# 로컬에는 보통 없다 — localhost로는 웹훅을 직접 받을 수 없기 때문이다.
# 배포 환경에서 미설정이면 /api/webhooks/clerk가 500을 돌려준다(400으로 뭉개면
# 위조 시도와 구분되지 않아 미러가 조용히 어긋난다).
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Pusher (실시간) ──────────────────────────────────────────
# 대시보드 > App Keys. key와 cluster만 클라이언트에 노출된다.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
