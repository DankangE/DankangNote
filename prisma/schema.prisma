generator client {
  provider = "prisma-client"
  output   = "../src/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id       String  @id @default(cuid())
  // 워크스페이스(테넌트) 스코프 = Clerk orgId. KAN-14에서 FK 소급 — webhook 동기화
  // 순서 경합은 생성 트랜잭션의 스켈레톤 upsert가 흡수한다(services/notes.ts).
  // 조직 삭제 시 노트는 함께 파기된다(Cascade — KAN-14에서 결정, KAN-12 항목 2 해소).
  orgId    String
  // 작성자 Clerk user id. FK 소급 이전 노트는 null, 작성자 탈퇴 시에도 null로 남는다.
  authorId String?

  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([authorId])
}

// 아래 세 모델은 Clerk의 사용자/조직/소속을 DB에 미러링한 것 — webhook으로만 채워진다.
// createdAt/updatedAt은 Clerk 원본 시각이 아니라 '이 행을 동기화한 시각'이다.

/// Clerk 사용자 미러. id는 Clerk user id(user_...). user.* 이벤트로 동기화.
model User {
  id             String    @id
  email          String?
  firstName      String?
  lastName       String?
  imageUrl       String?
  // Clerk 원본 updated_at — 이보다 오래된 이벤트는 무시하는 순서 역전 가드(KAN-12).
  // webhook을 거치지 않은 스켈레톤 행은 null.
  clerkUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships     Membership[]
  notes           Note[]
  boardCards      BoardCard[]
  createdChannels Channel[]
  channelMembers  ChannelMember[]
}

/// Clerk 조직(=워크스페이스) 미러. id는 Clerk org id(org_...). organization.* 이벤트로 동기화.
model Organization {
  id             String    @id
  name           String
  slug           String?
  imageUrl       String?
  // Clerk 원본 updated_at — 순서 역전 가드(KAN-12). 스켈레톤 행은 null.
  clerkUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships  Membership[]
  notes        Note[]
  boardColumns BoardColumn[]
  boardCards   BoardCard[]
  chatMessages ChatMessage[]
  channels     Channel[]
}

/// 채팅 채널 (KAN-28) — '워크스페이스당 방 1개'(KAN-15)를 대체한다.
/// orgId Cascade는 Note·BoardColumn과 같은 테넌트 수명 정책이다.
/// name은 org 안에서 유일하며 소문자로 정규화해 저장한다 — 'General'과 'general'이 다른
/// 채널로 갈라지면 슬랙식 `#이름` 멘탈 모델이 깨진다(정규화는 validation.ts).
model Channel {
  id    String  @id @default(cuid())
  orgId String
  name  String
  /// 채널 주제 — 헤더 부제로 쓰는 한 줄 설명.
  topic String?
  /// 비공개 채널은 ChannelMember 행이 곧 접근 권한이다(공개 채널은 조직 멤버 전체 공개).
  /// 생성 후 공개/비공개 전환은 지원하지 않는다 — 비공개→공개는 과거 대화가 통째로
  /// 노출되는 되돌릴 수 없는 사고라 별도 확인 UX 없이 열어둘 수 없다.
  isPrivate Boolean @default(false)
  /// 워크스페이스의 기본 채널(첫 착지점). 삭제할 수 없다 — 채널이 0개인 상태를 만들지
  /// 않기 위한 앵커이고, ensureDefaultChannel이 org당 정확히 하나를 보장한다.
  isDefault Boolean @default(false)
  /// 생성자 Clerk user id. 채널 수정·삭제 권한의 근거(작성자 본인 또는 org:admin — KAN-18
  /// 노트 규칙과 같다). 탈퇴 시 null이 되며, 그때는 admin만 관리할 수 있다.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members      ChannelMember[]
  messages     ChatMessage[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([createdById])
}

/// 채널 참여(슬랙식). 비공개 채널에선 이 행이 접근 권한 그 자체이고, 공개 채널에선
/// 사이드바 '내 채널' 구성용이다 — 공개 채널의 열람·전송은 조직 멤버 누구나 가능하다.
/// userId는 ChatMessage.authorId와 달리 FK를 둔다: 참여는 '지금 소속'이라 계정이 사라지면
/// 함께 사라지는 게 맞고(Cascade), 대화 로그처럼 보존할 이력이 아니다.
model ChannelMember {
  channelId String
  userId    String
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

/// 채널 메시지 (KAN-15 → KAN-28에서 채널 스코프로).
/// channelId Cascade — 채널 삭제 시 그 대화도 함께 파기된다. orgId는 채널을 거치지 않는
/// 테넌트 수준 쿼리(격리 어서션·후속 통합 검색)를 위해 남긴 비정규화 컬럼이며, 조직 삭제
/// 시의 Cascade 경로도 그대로다(KAN-19).
/// 웹훅이 아직 org 미러를 안 채운 시점의 전송은 createMessage의 스켈레톤 upsert가 흡수한다.
/// authorId는 Clerk user id지만 FK를 두지 않는다 — 전송이 User 미러의 동기화 순서에 묶이면
/// 안 되고, 여기에 SetNull FK를 달면 작성자 탈퇴 시 '누가 말했는지'가 사라져 대화 로그가
/// 깨진다. 대신 tombstone 가드가 삭제된 사용자의 쓰기를 막고, 표시용 조인은 서비스에서 한다.
/// parentId는 스레드 루트 메시지(KAN-30). null이면 채널 본문에 보이는 루트 메시지고,
/// 값이 있으면 그 루트의 답글이라 본문 목록에는 나오지 않는다. 답글의 답글은 만들지
/// 않는다(슬랙과 같은 1단계) — 그 규칙은 DB로 표현할 수 없어 createMessage가 강제한다.
/// 루트를 지우면 딸린 답글도 함께 파기된다(Cascade) — 맥락 없는 답글만 남는 게 더 나쁘다.
model ChatMessage {
  id        String   @id @default(cuid())
  orgId     String
  channelId String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent       ChatMessage?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ChatMessage[] @relation("MessageThread")

  @@index([orgId, createdAt])
  // 채널 본문은 루트만 훑고(parentId IS NULL) 스레드는 한 루트의 답글만 훑는다 — 둘 다
  // 이 인덱스로 커버된다. 키셋 커서(KAN-29)의 시작 경계도 그대로 유지된다.
  @@index([channelId, parentId, createdAt])
  @@index([parentId, createdAt])
}

/// 사용자↔조직 소속과 역할. id는 Clerk membership id(orgmem_...). organizationMembership.* 이벤트로 동기화.
model Membership {
  id             String    @id
  orgId          String
  userId         String
  // Clerk 역할 문자열 (예: 'org:admin', 'org:member').
  role           String
  // Clerk 원본 updated_at — 순서 역전 가드(KAN-12). 삭제→재초대 사이클을 가로질러
  // 지연 도착한 옛 id 이벤트가 행을 되돌리는 유령 멤버십 경로를 막는다.
  clerkUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// Clerk가 삭제를 통보한 id의 영구 기록(KAN-12) — 지연 재전송된 upsert 이벤트나
/// stale 세션의 스켈레톤 생성이 삭제된 미러를 부활시키지 못하게 한다.
/// Clerk id는 재사용되지 않으므로 만료·정리가 필요 없다.
model ClerkTombstone {
  id        String   @id
  deletedAt DateTime @default(now())
}

/// 칸반 보드 컬럼 (워크스페이스당 보드 1개, KAN-17). orgId는 Note와 같은 FK 패턴 —
/// 조직 삭제 시 컬럼·카드까지 Cascade로 파기된다. position은 표시 순서(정수, 0부터).
model BoardColumn {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cards        BoardCard[]

  @@index([orgId])
}

/// 칸반 보드 카드. columnId Cascade — 컬럼 삭제 시 카드도 파기. authorId는 Note와 같은
/// 패턴(nullable FK, 작성자 탈퇴 시 SetNull). position은 컬럼 내 순서 — 이동 시 대상 컬럼의
/// 카드 position을 0..n으로 재작성한다(정수, 부동소수 정밀도 회피).
model BoardCard {
  id        String   @id @default(cuid())
  orgId     String
  columnId  String
  authorId  String?
  text      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  column       BoardColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([columnId])
  @@index([authorId])
}
