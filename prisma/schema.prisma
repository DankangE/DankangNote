generator client {
  provider = "prisma-client"
  output   = "../src/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id       String  @id @default(cuid())
  // 워크스페이스(테넌트) 스코프 = Clerk orgId. KAN-14에서 FK 소급 — webhook 동기화
  // 순서 경합은 생성 트랜잭션의 스켈레톤 upsert가 흡수한다(services/notes.ts).
  // 조직 삭제 시 노트는 함께 파기된다(Cascade — KAN-14에서 결정, KAN-12 항목 2 해소).
  orgId    String
  // 작성자 Clerk user id. FK 소급 이전 노트는 null, 작성자 탈퇴 시에도 null로 남는다.
  authorId String?
  /// 문서 트리(KAN-37). null이면 루트 문서. 부모 삭제 시 자식은 루트로 승격된다(SetNull) —
  /// Cascade면 작성자 권한(KAN-18)으로 자기 노트 하나를 지우며 남의 하위 문서까지 파기할
  /// 수 있어 권한 모델이 깨진다. 조직 삭제의 전체 파기는 orgId Cascade가 그대로 담당한다.
  /// 사이클 방지는 DB로 표현할 수 없어 moveNote가 재귀 CTE로 강제한다(services/notes.ts).
  parentId String?
  /// 같은 부모 안에서의 수동 정렬 순서 — 보드(KAN-17)와 같은 패턴: 생성은 max+1 append,
  /// 이동 시 대상 형제 그룹을 0..n으로 재작성. gap은 정렬에 무해하다. SetNull 승격으로
  /// 루트에 편입된 문서는 옛 그룹의 position을 그대로 들고 오므로 (position, createdAt)
  /// 복합 정렬로 순서를 결정적으로 유지한다.
  position Int     @default(0)

  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author       User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent       Note?            @relation("NoteTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Note[]           @relation("NoteTree")
  favorites    NoteFavorite[]
  attachmentRefs NoteAttachmentRef[]

  // 트리 조회·형제 그룹 재작성은 전부 (orgId, parentId) 스코프로 온다.
  @@index([orgId, parentId])
  @@index([authorId])
}

/// 노트 본문 이미지의 **오브젝트** (KAN-38) — MessageAttachment(KAN-35)와 같은 수명 구조:
/// presign 시 참조 없는 행, 저장 시 본문이 참조하는 것만 바인딩. 본문에서 빠져 참조가
/// 0이 된 첨부는 저장 트랜잭션이 행을 지우며 키를 outbox(KAN-70)에 적고, 노트 삭제도 같은
/// 방식으로 키를 먼저 적는다(cascade만 믿으면 행과 함께 '지울 좌표'가 사라진다). 키는
/// 채팅과 같은 org/{orgId}/att/ 프리픽스라 조직 삭제의 프리픽스 정리가 그대로 덮는다.
///
/// 어느 노트가 쓰는지는 NoteAttachmentRef가 들고 있다 — 참조를 1:N으로 뗀 이유는 KAN-71:
/// 이미지 블록을 다른 문서로 복사하는 정상적인 흐름이 1:1 모델에서는 '남의 첨부를 실어
/// 왔다'와 구분되지 않아 저장이 통째로 거부됐고, 원본 노트에서 그 이미지를 빼는 순간
/// 오브젝트까지 지워져 복사본이 영영 저장 불가가 됐다.
model NoteAttachment {
  id          String   @id @default(cuid())
  orgId       String
  uploaderId  String
  key         String   @unique
  fileName    String
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  refs         NoteAttachmentRef[]

  @@index([orgId])
}

/// 노트 ↔ 첨부 참조. 행이 없으면 pending(업로더 본인에게만 보이고 24h 스윕 대상)이고,
/// 마지막 행이 사라지면 오브젝트를 지운다 — 즉 이 표가 곧 참조 카운트다.
///
/// NoteFavorite와 달리 orgId를 싣지 않는다(규약 1의 의도된 예외): 이 표를 org로 조회하는
/// 경로가 없다 — 행을 만드는 곳은 syncNoteAttachments 하나뿐이고 거기서 첨부는 orgId로,
/// noteId는 호출자의 org 스코프 update가 이미 판정했다. 파기는 양쪽 FK Cascade가 덮는다.
/// 비정규화한 orgId는 여기서는 '두 번째 진실'이 될 뿐이라 판정에 쓰이지 않는 컬럼이 된다.
model NoteAttachmentRef {
  noteId       String
  attachmentId String

  note       Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  attachment NoteAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@id([noteId, attachmentId])
  @@index([attachmentId])
}

/// 노트 즐겨찾기 (KAN-37) — 사용자별 상태라 행의 존재가 곧 토글이다(MessageReaction과
/// 같은 의미론, 동시 클릭 경합은 복합 PK가 막는다). userId FK Cascade — '지금의 선호'라
/// 계정과 함께 사라지는 게 맞다(ChannelMember와 같은 결정). orgId는 사이드바 즐겨찾기
/// 목록을 노트 조인 없이 테넌트 스코프로 긁기 위한 비정규화 + 규약 6의 Cascade 경로.
model NoteFavorite {
  noteId    String
  userId    String
  orgId     String
  createdAt DateTime @default(now())

  note         Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId, orgId])
  @@index([orgId])
}

// 아래 세 모델은 Clerk의 사용자/조직/소속을 DB에 미러링한 것 — webhook으로만 채워진다.
// createdAt/updatedAt은 Clerk 원본 시각이 아니라 '이 행을 동기화한 시각'이다.

/// Clerk 사용자 미러. id는 Clerk user id(user_...). user.* 이벤트로 동기화.
model User {
  id             String    @id
  email          String?
  firstName      String?
  lastName       String?
  imageUrl       String?
  // Clerk 원본 updated_at — 이보다 오래된 이벤트는 무시하는 순서 역전 가드(KAN-12).
  // webhook을 거치지 않은 스켈레톤 행은 null.
  clerkUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships     Membership[]
  notes           Note[]
  noteFavorites   NoteFavorite[]
  boardCards      BoardCard[]
  createdChannels Channel[]
  channelMembers  ChannelMember[]
}

/// Clerk 조직(=워크스페이스) 미러. id는 Clerk org id(org_...). organization.* 이벤트로 동기화.
model Organization {
  id             String    @id
  name           String
  slug           String?
  imageUrl       String?
  // Clerk 원본 updated_at — 순서 역전 가드(KAN-12). 스켈레톤 행은 null.
  clerkUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships     Membership[]
  notes           Note[]
  noteFavorites   NoteFavorite[]
  noteAttachments NoteAttachment[]
  boardColumns    BoardColumn[]
  boardCards   BoardCard[]
  chatMessages  ChatMessage[]
  channels      Channel[]
  reactions     MessageReaction[]
  mentions      MessageMention[]
  notifications Notification[]
  reads         ChannelRead[]
  attachments   MessageAttachment[]
}

/// 채팅 채널 (KAN-28) — '워크스페이스당 방 1개'(KAN-15)를 대체한다.
/// orgId Cascade는 Note·BoardColumn과 같은 테넌트 수명 정책이다.
/// name은 org 안에서 유일하며 소문자로 정규화해 저장한다 — 'General'과 'general'이 다른
/// 채널로 갈라지면 슬랙식 `#이름` 멘탈 모델이 깨진다(정규화는 validation.ts).
model Channel {
  id    String  @id @default(cuid())
  orgId String
  name  String
  /// 채널 주제 — 헤더 부제로 쓰는 한 줄 설명.
  topic String?
  /// 비공개 채널은 ChannelMember 행이 곧 접근 권한이다(공개 채널은 조직 멤버 전체 공개).
  /// 생성 후 공개/비공개 전환은 지원하지 않는다 — 비공개→공개는 과거 대화가 통째로
  /// 노출되는 되돌릴 수 없는 사고라 별도 확인 UX 없이 열어둘 수 없다.
  isPrivate Boolean @default(false)
  /// 워크스페이스의 기본 채널(첫 착지점). 삭제할 수 없다 — 채널이 0개인 상태를 만들지
  /// 않기 위한 앵커이고, ensureDefaultChannel이 org당 정확히 하나를 보장한다.
  isDefault Boolean @default(false)
  /// 생성자 Clerk user id. 채널 수정·삭제 권한의 근거(작성자 본인 또는 org:admin — KAN-18
  /// 노트 규칙과 같다). 탈퇴 시 null이 되며, 그때는 admin만 관리할 수 있다.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// 이 채널에 마지막으로 부여한 메시지 순번 (KAN-55). 전송 트랜잭션이 이 행을 잠그고
  /// +1 해서 ChatMessage.seq로 쓴다 — 그래서 순번 순서가 곧 **커밋 순서**다(자세한 근거는
  /// ChatMessage.seq 주석). 롤백되면 증가도 함께 되돌아가 번호에 구멍이 남지 않는다.
  messageSeq  Int      @default(0)

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members       ChannelMember[]
  messages      ChatMessage[]
  notifications Notification[]
  reads         ChannelRead[]
  attachments   MessageAttachment[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([createdById])
}

/// 채널 참여(슬랙식). 비공개 채널에선 이 행이 접근 권한 그 자체이고, 공개 채널에선
/// 사이드바 '내 채널' 구성용이다 — 공개 채널의 열람·전송은 조직 멤버 누구나 가능하다.
/// userId는 ChatMessage.authorId와 달리 FK를 둔다: 참여는 '지금 소속'이라 계정이 사라지면
/// 함께 사라지는 게 맞고(Cascade), 대화 로그처럼 보존할 이력이 아니다.
model ChannelMember {
  channelId String
  userId    String
  createdAt DateTime @default(now())
  /// 참여한 순간의 채널 순번 (KAN-55). '참여 이전 이력은 안읽음이 아니다'의 기준선이다 —
  /// 한때 createdAt(참여 시각)과 메시지 시각을 비교했는데, 그 둘은 서로 다른 앱 프로세스의
  /// 시계라 비교할 근거가 없었다. 같은 채널의 순번끼리 비교하면 그 문제가 사라진다.
  joinedSeq Int      @default(0)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

/// 채널 메시지 (KAN-15 → KAN-28에서 채널 스코프로).
/// channelId Cascade — 채널 삭제 시 그 대화도 함께 파기된다. orgId는 채널을 거치지 않는
/// 테넌트 수준 쿼리(격리 어서션·후속 통합 검색)를 위해 남긴 비정규화 컬럼이며, 조직 삭제
/// 시의 Cascade 경로도 그대로다(KAN-19).
/// 웹훅이 아직 org 미러를 안 채운 시점의 전송은 createMessage의 스켈레톤 upsert가 흡수한다.
/// authorId는 Clerk user id지만 FK를 두지 않는다 — 전송이 User 미러의 동기화 순서에 묶이면
/// 안 되고, 여기에 SetNull FK를 달면 작성자 탈퇴 시 '누가 말했는지'가 사라져 대화 로그가
/// 깨진다. 대신 tombstone 가드가 삭제된 사용자의 쓰기를 막고, 표시용 조인은 서비스에서 한다.
/// parentId는 스레드 루트 메시지(KAN-30). null이면 채널 본문에 보이는 루트 메시지고,
/// 값이 있으면 그 루트의 답글이라 본문 목록에는 나오지 않는다. 답글의 답글은 만들지
/// 않는다(슬랙과 같은 1단계) — 그 규칙은 DB로 표현할 수 없어 createMessage가 강제한다.
/// 루트를 지우면 딸린 답글도 함께 파기된다(Cascade) — 맥락 없는 답글만 남는 게 더 나쁘다.
model ChatMessage {
  id        String   @id @default(cuid())
  orgId     String
  channelId String
  authorId  String
  parentId  String?
  body      String
  /// 채널 안에서의 순번 (KAN-55). **정렬·커서의 유일한 근거다.** createdAt은 표시용으로만
  /// 남는다.
  ///
  /// 왜 시각이 아닌가: createdAt은 INSERT를 실행한 앱 프로세스의 벽시계다(스키마에 DEFAULT
  /// CURRENT_TIMESTAMP가 있어도 Prisma가 값을 바인드 파라미터로 보내 DB 기본값은 쓰이지
  /// 않는다 — 실측). 인스턴스가 둘 이상이면 NTP 스큐가 그대로 메시지 순서가 된다.
  ///
  /// 왜 시퀀스(BIGSERIAL)가 아닌가: 시퀀스 값은 INSERT 시점에 뽑히므로 **커밋 순서와
  /// 어긋날 수 있다**. 늦게 커밋된 작은 번호는 이미 전진한 읽음 커서 아래에 깔려 영영
  /// 안읽음에서 빠진다(KAN-55의 실측 시나리오).
  ///
  /// 이 컬럼은 Channel.messageSeq를 UPDATE ... RETURNING으로 +1 해서 받는다. 그 행 잠금은
  /// 커밋까지 유지되므로 뒤이은 전송은 앞 전송이 커밋하기 전에는 번호를 받지 못한다 —
  /// 즉 **번호 순서 = 커밋 순서**이고, 카운터는 번호를 건너뛰지 않는다(롤백된 전송의 번호는
  /// 다음 전송이 받는다). 반대로 **seq 값이 1..N으로 연속이라는 뜻은 아니다** — 커밋된
  /// 메시지가 지워지면(cascade, tombstone 사후 정리) 그 번호는 비어 남는다. 커서는
  /// `seq > baseline`, 키셋은 `seq < anchor`라 빈 번호는 무해하지만, 연속성에 기대는 계산
  /// (개수를 빼서 세기 같은)을 얹으면 그때부터 조용히 틀린다. 대가는 같은 채널로의 동시 전송이
  /// 그 행에서 직렬화된다는 것인데, 채널 하나의 전송은 사람이 치는 속도라 실질적 상한이
  /// 아니다. 순서 정합성을 얻는 값으로 싸다.
  seq       Int
  /// 이 메시지의 리액션 집계 버전 (KAN-52). 토글 트랜잭션이 이 행을 잠그고 +1 해서 델타에
  /// 싣는다 — seq와 같은 장치이고 같은 이유다(번호 순서 = 커밋 순서). 수신 측은 자기가
  /// 마지막에 적용한 것보다 낮은 델타를 버려, 늦게 도착한 옛 절대 count가 화면을 과거로
  /// 되돌리지 못하게 한다.
  ///
  /// 채널 카운터(Channel.messageSeq)를 같이 쓰지 않는 이유는 빈도다. 리액션은 메시지보다
  /// 훨씬 잦아, 채널 행에서 직렬화하면 리액션 몇 번이 전송까지 함께 막는다. 메시지 단위로
  /// 두면 경합이 '같은 말풍선을 동시에 누른 사람들'로 좁혀진다.
  reactionSeq Int  @default(0)
  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent       ChatMessage?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ChatMessage[] @relation("MessageThread")

  @@index([orgId, createdAt])
  // 채널 본문 목록은 (channelId, seq) 역스캔으로 뽑고 parentId IS NULL은 필터로 걸러진다.
  // 한때 parentId를 인덱스 가운데에 끼웠는데 그건 틀렸다 — IS NULL은 등호가 아니라
  // NullTest라 정렬 pathkey가 성립하지 않아 오히려 Sort가 붙는다. 답글이 96%인 채널에서도
  // 이 형태가 52행만 읽고 끝난다(실측 15 buffers / 0.27ms).
  //
  // unique인 것은 성능이 아니라 불변식이다: 한 채널에 같은 번호가 둘이면 커서가 어느 쪽을
  // 가리키는지 정할 수 없다. 카운터를 우회해 seq를 직접 넣는 코드가 생기면 여기서 죽는다.
  @@unique([channelId, seq])
  // 스레드 조회는 parentId가 등호라 이 인덱스로 정렬까지 해결된다.
  @@index([parentId, seq])

  reactions     MessageReaction[]
  mentions      MessageMention[]
  notifications Notification[]
  attachments   MessageAttachment[]
}

/// 메시지 첨부 (KAN-35). 업로드는 두 단계다.
/// ① presign — 행을 먼저 만들고(messageId null) 브라우저가 스토리지에 **직접** 올린다.
///   서버를 거치면 서버리스 본문 상한(4.5MB)이 곧 파일 상한이 된다.
/// ② 전송 — sendMessage 트랜잭션이 messageId를 채워 바인딩한다. 그 updateMany의 where가
///   (orgId, channelId, uploaderId, messageId: null)를 전부 물으므로, 남의 업로드·다른
///   채널의 업로드·이미 쓴 업로드는 **매칭 자체가 안 된다** — 행이 곧 소유권 증명이다.
///
/// uploaderId에 FK가 없는 것은 ChatMessage.authorId와 같은 이유다(업로드가 User 미러의
/// 웹훅 동기화 순서에 묶이면 안 된다). 행 수명은 org/channel/message Cascade로 닫혀 있다.
/// 전송 없이 버려진 pending 행(messageId null)도 채널·조직이 지워지면 함께 파기된다.
///
/// **스토리지 오브젝트의 수명은 행과 다르다** — 행이 cascade로 지워져도 오브젝트는 남는다.
/// 키가 org/{orgId}/ 프리픽스라 나중에 프리픽스 삭제로 정리할 수 있고, 그 정리는 별도
/// 티켓이다(웹훅 핸들러가 스토리지 API 실패까지 떠안게 되는 설계 변경이라 여기서 안 한다).
model MessageAttachment {
  id          String   @id @default(cuid())
  orgId       String
  channelId   String
  uploaderId  String
  /// 바인딩 전(pending)에는 null. 값이 있으면 그 메시지의 첨부로 화면에 보인다.
  messageId   String?
  /// 스토리지 오브젝트 키 — org/{orgId}/att/{uuid}. 파일명을 키에 넣지 않는 것은 의도다:
  /// 유니코드·경로 문자가 서명과 URL 인코딩을 지나며 어긋날 자리를 만들지 않는다.
  /// 파일명은 fileName 컬럼에 남아 다운로드 시 Content-Disposition으로 실린다.
  key         String   @unique
  fileName    String
  contentType String
  /// presign 시점에 선언된 크기. 실제 상한 강제는 스토리지의 POST 정책이 한다(storage.ts).
  size        Int
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message      ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // 페이지의 메시지 id들로 첨부를 접는 조회(loadAttachments)가 선두 messageId를 탄다.
  @@index([messageId])
  @@index([channelId])
  @@index([orgId])
}

/// 스토리지 정리 outbox (KAN-70) — '지울 오브젝트의 좌표'를 행으로 먼저 적고, 실제
/// 스토리지 호출은 cron 스윕이 나중에 한다(storage-cleanup.ts).
///
/// 삭제 트랜잭션(조직 웹훅·채널 삭제)에 스토리지 API를 직접 넣지 않는 이유: 부분 실패
/// (DB는 지웠는데 스토리지 호출이 실패)라는 새 상태가 생기고, 재시도 시점엔 첨부 행이
/// 이미 cascade로 사라져 지울 키 목록을 모른다. 좌표를 같은 트랜잭션에서 여기 남기면
/// DB 커밋과 '지울 것' 기록이 원자이고, 스토리지 삭제는 멱등이라 몇 번이고 다시 시도할
/// 수 있다.
///
/// 의도적으로 orgId FK가 없다 — 이 행은 조직 행이 파기된 **뒤에도** 남아야 하는 운영
/// 데이터다(남는 것이 존재 이유다). 읽는 주체도 테넌트가 아니라 cron뿐이다.
model StorageCleanup {
  id        String   @id @default(cuid())
  /// 'key' = 오브젝트 단건(채널 삭제·버려진 pending), 'prefix' = 프리픽스 전체(조직 삭제 —
  /// 행 없이도 org/{orgId}/att/ 라는 좌표가 성립한다).
  kind      String
  /// 지울 좌표(키 또는 프리픽스). unique라 웹훅 재배달·중복 스윕의 enqueue가 멱등하다
  /// (createMany skipDuplicates).
  target    String   @unique
  /// 실패 횟수 — 처리 순서를 뒤로 미는 용도(포이즌 행이 새 작업을 막지 않게). 상한은 두지
  /// 않는다: 지울 것이 남아 있는 한 행이 남아 있는 게 맞고, cron 주기 재시도는 싸다.
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 채널 읽음 커서 (KAN-33) — 사람×채널마다 한 행.
///
/// 안읽음을 카운터로 들고 있지 않고 **어디까지 읽었는지**만 남긴다. 카운터는 증감을
/// 놓치거나 두 번 세는 순간 조용히 어긋난 채 굳고, 되돌릴 근거가 없다. 커서는 언제든
/// '그 뒤에 온 것'을 다시 세면 되므로 스스로 회복한다.
///
/// 커서는 채널 순번 하나다 (KAN-55). 한때 (createdAt, id) 복합 키였는데, 그 시각이 앱
/// 프로세스 시계였던 탓에 '늦게 커밋된 옛 시각' 메시지가 커서 아래에 깔려 영영 안읽음에서
/// 빠졌다. 순번은 커밋 순서와 같아서 그 구멍이 없고, 동률을 가를 id도 필요 없다.
///
/// userId에 FK를 두지 않는 것은 ChatMessage.authorId와 같은 이유다. 수명은 channelId·orgId
/// Cascade로 닫혀 있다.
model ChannelRead {
  channelId   String
  userId      String
  orgId       String
  lastReadSeq Int
  updatedAt   DateTime @updatedAt

  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  // 사이드바는 '내 채널 전부'의 커서를 한 번에 읽는다 — userId가 선두여야 그 조회가
  // 인덱스를 탄다(복합 기본키는 channelId가 선두라 쓸 수 없다).
  @@index([userId, orgId])
}

/// 메시지 안의 멘션 한 건 (KAN-32).
///
/// 본문에는 사람이 읽는 텍스트("@단 강")가 그대로 남고, 이 행은 그 텍스트가 **누구를**
/// 가리켰는지와 본문 어디를 차지하는지를 들고 있다. 불투명 토큰(`<@user_2abc>`)을 본문에
/// 박는 슬랙 방식을 쓰지 않은 이유는 이 프로젝트의 컴포저가 평문 textarea라 토큰이 그대로
/// 사용자에게 보이기 때문이고, 반대로 렌더 시점에 "@이름"을 다시 파싱하지 않는 이유는
/// 동명이인과 개명에 무너지기 때문이다. 보낼 때 확정하고, 그 결과를 여기 남긴다.
///
/// start/length는 보낸 순간의 본문 기준이다. 나중에 이름이 바뀌어도 과거 메시지의 강조
/// 구간은 그대로다 — 메시지는 그때 한 말 그대로여야 한다.
model MessageMention {
  messageId String
  /// 본문에서 이 멘션이 시작하는 위치(코드 유닛). 한 메시지 안에서 유일하므로 키가 된다.
  start     Int
  length    Int
  /// 'user' | 'channel'. channel 멘션은 대상이 채널 참여자 전체라 userId가 없다.
  kind      String
  userId    String?
  orgId     String

  message      ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([messageId, start])
  @@index([orgId])
}

/// 인앱 알림 한 건 (KAN-32). 받는 사람마다 한 행이다 — 안읽음 판정이 사람마다 다르고,
/// 그걸 메시지 쪽에 두면 읽음 상태가 모든 수신자의 공유 상태가 된다.
///
/// (messageId, userId) 유니크 — 한 메시지가 같은 사람을 여러 번 멘션해도 알림은 하나다.
/// @channel과 개인 멘션이 겹쳐도 마찬가지고, 그 유일성이 생성을 멱등하게 만든다.
///
/// userId·actorId에 FK를 두지 않는 것은 ChatMessage.authorId와 같은 이유다(웹훅 동기화
/// 순서에 묶이면 안 된다). 수명은 orgId·channelId·messageId Cascade로 이미 닫혀 있다.
model Notification {
  id        String    @id @default(cuid())
  orgId     String
  /// 받는 사람.
  userId    String
  /// 알림을 일으킨 사람. 자기 자신에게는 만들지 않는다.
  actorId   String
  /// 'mention' | 'channel'.
  kind      String
  channelId String
  messageId String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message      ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  // 알림 목록 — 내 것을 최신순으로. 커서 페이지네이션도 이 인덱스를 탄다.
  @@index([userId, orgId, createdAt])
  // 안읽음 뱃지 — readAt IS NULL은 NullTest라 정렬엔 못 쓰지만, count에는 그대로 유효하다.
  @@index([userId, orgId, readAt])
}

/// 메시지 이모지 리액션 (KAN-31). 한 사람이 한 메시지에 같은 이모지를 두 번 누를 수 없다 —
/// 그 유일성이 곧 토글의 의미고, 동시 클릭 경합도 DB가 막는다(@@unique).
/// emoji는 자유 문자열이 아니라 고정 팔레트의 한 값이다(features/chat/reactions.ts) —
/// 임의 문자열을 허용하면 그게 남의 화면에 그대로 렌더되는 저장형 입력이 된다.
/// orgId는 ChatMessage와 같은 이유의 비정규화 컬럼이다: messageId Cascade만으로도 수명은
/// 성립하지만, 테넌트 데이터는 예외 없이 orgId로 스코프한다는 규칙을 여기서만 비우지 않는다.
/// userId에 FK를 두지 않는 것도 ChatMessage.authorId와 같다 — 리액션이 User 미러의 웹훅
/// 동기화 순서에 묶이면 안 된다. 삭제된 사용자의 쓰기는 tombstone 가드가 막는다.
model MessageReaction {
  messageId String
  userId    String
  emoji     String
  orgId     String
  createdAt DateTime @default(now())

  message      ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // 유니크 제약이 곧 기본키다 — 대리키를 따로 둘 이유가 없다(ChannelMember와 같은 형태).
  @@id([messageId, userId, emoji])
  // 페이지의 메시지 id들로 카운트를 접는 groupBy가 이 인덱스를 탄다. 선두가 messageId라
  // 위 복합 기본키 인덱스로 충분해 별도 인덱스는 두지 않는다.
  @@index([orgId])
}

/// 사용자↔조직 소속과 역할. id는 Clerk membership id(orgmem_...). organizationMembership.* 이벤트로 동기화.
model Membership {
  id             String    @id
  orgId          String
  userId         String
  // Clerk 역할 문자열 (예: 'org:admin', 'org:member').
  role           String
  // Clerk 원본 updated_at — 순서 역전 가드(KAN-12). 삭제→재초대 사이클을 가로질러
  // 지연 도착한 옛 id 이벤트가 행을 되돌리는 유령 멤버십 경로를 막는다.
  clerkUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// Clerk가 삭제를 통보한 id의 영구 기록(KAN-12) — 지연 재전송된 upsert 이벤트나
/// stale 세션의 스켈레톤 생성이 삭제된 미러를 부활시키지 못하게 한다.
/// Clerk id는 재사용되지 않으므로 만료·정리가 필요 없다.
model ClerkTombstone {
  id        String   @id
  deletedAt DateTime @default(now())
}

/// (userId, resource) 최소 간격 레이트 리밋의 기록 (KAN-57) — 마지막으로 허용된 시각 한 행.
///
/// 카운터·슬라이딩 윈도우가 아니라 시각 하나인 이유는 읽음 커서와 같다(규약 16): 증감을
/// 놓치면 어긋난 채 굳는 파생 수치를 들지 않고, '마지막 허용에서 충분히 지났는가'만 다시
/// 물으면 스스로 회복한다. 저장소가 Postgres인 이유: 인스턴스 간 공유되는 저장소가 스택에
/// 이것뿐이다 — 전용 스토어(Redis류)는 새 계정 연결이 필요한데 그게 KAN-27이 막힌 지점이고,
/// 지키려는 것(Pusher 쿼터·팬아웃)이 DB 문장 하나보다 훨씬 비싸다.
///
/// userId에 FK가 없는 것은 ChatMessage.authorId와 같은 이유다(웹훅 동기화 순서에 묶이면
/// 안 된다). orgId가 없는 것은 이 행이 테넌트 데이터가 아니어서다 — 내용 없이 불투명
/// 리소스 키와 시각뿐이고, 사람 단위로 스코프되며, 어떤 화면에도 조회되지 않는다.
/// resource에는 유계 집합의 키만 온다(rate-limit.ts 계약 — 첫 사용처는 정적 'typing').
/// 그래서 행 수는 사용자 × 리소스 종류로 유계고 요청이 행 수를 늘릴 수 없다. 다만 FK가
/// 없어 떠난 사용자의 행은 남는다 — 규약 6의 잔여로, 낡은 행 정리(lastAt 기준 주기
/// 삭제)는 KAN-48에 매달아 둔다.
///
/// lastAt은 앱 시계가 아니라 DB의 now()다 — 판정과 기록이 같은 시계여야 인스턴스
/// 스큐가 간격을 왜곡하지 못한다(규약 20과 같은 이유). @default(now())를 일부러 안 둔
/// 것도 같은 결이다 — 기본값에 기대는 순간 Prisma가 앱 시계를 바인드해 보낸다(규약 20).
/// 전 스키마에서 이 컬럼만 timestamptz인 이유: 값을 쓰고 비교하는 주체가 앱이 아니라
/// DB(now())인 유일한 컬럼이라, timestamp(3)이면 timestamptz→timestamp 캐스트가 세션
/// TimeZone을 타서 UTC가 아닌 배포에서 DST 전환이 간격 판정을 시간 단위로 왜곡한다.
model RateLimit {
  userId   String
  resource String
  lastAt   DateTime @db.Timestamptz(3)

  @@id([userId, resource])
}

/// 칸반 보드 컬럼 (워크스페이스당 보드 1개, KAN-17). orgId는 Note와 같은 FK 패턴 —
/// 조직 삭제 시 컬럼·카드까지 Cascade로 파기된다. position은 표시 순서(정수, 0부터).
model BoardColumn {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cards        BoardCard[]

  @@index([orgId])
}

/// 칸반 보드 카드. columnId Cascade — 컬럼 삭제 시 카드도 파기. authorId는 Note와 같은
/// 패턴(nullable FK, 작성자 탈퇴 시 SetNull). position은 컬럼 내 순서 — 이동 시 대상 컬럼의
/// 카드 position을 0..n으로 재작성한다(정수, 부동소수 정밀도 회피).
model BoardCard {
  id        String   @id @default(cuid())
  orgId     String
  columnId  String
  authorId  String?
  text      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  column       BoardColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([columnId])
  @@index([authorId])
}
